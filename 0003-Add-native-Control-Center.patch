+.field static final AGSL:Ljava/lang/String; = "uniform shader backdrop;\nuniform shader backdropFrom;\nuniform float bdMix;\nuniform float4 bdMap;\nuniform float4 box;\nuniform float3 corner;\nuniform float4 lens;\nuniform float4 colorCtl;\nuniform float zoom;\nlayout(color) uniform half4 tint;\nlayout(color) uniform half4 surface;\nuniform float4 rim;\nuniform float4 light;\nuniform float4 edge;\nuniform float4 shade;\nuniform float2 innerShade;\nuniform float4 press;\nuniform float3 misc;\nuniform float4 box2;\nuniform float3 corner2;\nuniform float4 mrg;\nuniform float4 under;\nlayout(color) uniform half4 underColor;\nuniform float4 underXf;\nfloat sdRound(float2 p, float2 hs, float3 cr) {\n    float a = cr.y;\n    float2 q = abs(p) - (hs - float2(a));\n    float2 m = max(q, 0.0);\n    float len = length(m);\n    if (cr.z > 2.01) {\n        float2 u = max(m / max(a, 0.0001), float2(0.000001));\n        len = pow(pow(u.x, cr.z) + pow(u.y, cr.z), 1.0 / cr.z) * a;\n    }\n    return len + min(max(q.x, q.y), 0.0) - a;\n}\nfloat sminH(float a, float b, float k) {\n    return clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);\n}\nfloat sdAll(float2 c) {\n    float a = sdRound(c - (box.xy + box.zw) * 0.5, (box.zw - box.xy) * 0.5, corner);\n    if (mrg.x <= 0.0) return a;\n    float b = sdRound(c - (box2.xy + box2.zw) * 0.5, (box2.zw - box2.xy) * 0.5, corner2);\n    float h = sminH(a, b, mrg.x);\n    return mix(b, a, h) - mrg.x * h * (1.0 - h);\n}\nfloat2 gradBox(float2 p, float2 hs, float r) {\n    float2 sg = float2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);\n    float2 cc = abs(p) - (hs - float2(r));\n    if (cc.x >= 0.0 || cc.y >= 0.0) {\n        float2 mc = max(cc, 0.0);\n        float l = length(mc);\n        if (l > 0.0) return sg * (mc / l);\n        return cc.x >= 0.0 ? float2(sg.x, 0.0) : float2(0.0, sg.y);\n    }\n    float gx = step(cc.y, cc.x);\n    return sg * float2(gx, 1.0 - gx);\n}\nfloat phi(float x) {\n    return 1.0 / (1.0 + exp(-1.7 * x));\n}\nfloat3